# Supabase project > Connect / Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Optional legacy alternative: use this ONLY if you are using the anon key.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_legacy_anon_key

# Update after Vercel gives you your final domain. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# No secret/service_role key or Neon connection string is needed.

# Show labelled local sample work in empty collections (default: true).
# Set false when you want only your published real work.
PORTFOLIO_SHOW_SAMPLES=true
